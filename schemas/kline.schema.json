{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/umtong/SMC_ICT_3_LIVE/schemas/kline.schema.json",
  "title": "SMC/ICT normalized kline logical record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exchange", "market_path", "dataset", "dataset_kind", "symbol", "interval",
    "open_time_us", "close_time_exclusive_us", "available_time_us",
    "open", "high", "low", "close", "source_url", "source_sha256",
    "archive_id", "pipeline_version"
  ],
  "properties": {
    "exchange": {"type": "string", "const": "binance"},
    "market_path": {"type": "string", "enum": ["spot", "futures/um"]},
    "dataset": {"type": "string", "enum": ["klines", "markPriceKlines", "indexPriceKlines", "premiumIndexKlines"]},
    "dataset_kind": {"type": "string", "enum": ["kline", "reference_kline"]},
    "symbol": {"type": "string", "pattern": "^(BTC|ETH|XRP|SOL)USDT$"},
    "interval": {"type": "string", "pattern": "^[1-9][0-9]*[smhdw]$"},
    "open_time_us": {"type": "integer"},
    "close_time_exclusive_us": {"type": "integer"},
    "available_time_us": {"type": "integer"},
    "source_close_time_us": {"type": ["integer", "string"]},
    "open": {"type": "string"},
    "high": {"type": "string"},
    "low": {"type": "string"},
    "close": {"type": "string"},
    "base_volume": {"type": "string"},
    "quote_volume": {"type": "string"},
    "trade_count": {"type": "string"},
    "taker_buy_base_volume": {"type": "string"},
    "taker_buy_quote_volume": {"type": "string"},
    "source_field_5": {"type": "string"},
    "source_field_7": {"type": "string"},
    "source_field_8": {"type": "string"},
    "source_field_9": {"type": "string"},
    "source_field_10": {"type": "string"},
    "source_field_11": {"type": "string"},
    "source_url": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "archive_id": {"type": "string"},
    "pipeline_version": {"type": "string"}
  }
}
