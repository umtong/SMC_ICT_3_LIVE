.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
build/
dist/
*.egg-info/

# Local acquisition/build workspaces are generated and never committed.
data/raw/
data/silver/
data/gold/
data/quality/
data/catalog/
*.zip
*.parquet
*.csv.gz
*.duckdb

# The versioned, validated default research release is intentionally committed.
!data/prepared/
!data/prepared/**

# Keep reproducibility metadata.
!data/manifests/
!data/manifests/*.csv
!data/manifests/*.json
!data/manifests/*.jsonl

# Full-history candidate manifests are generated release artifacts.
data/manifests/full_history_candidates_*.csv
